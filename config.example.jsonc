// Every option a configuration can carry, with its default. Copy this file to
// config.jsonc, which is machine-local and gitignored, and uncomment what you
// want to change. Nothing has to be set: every option here has a default.
{
  // Where LLVM, alive2, llubi and llops were built. They read and write the
  // same IR, so they have to be one build against one LLVM; `make install-deps
  // TOOLCHAIN=<dir>` builds it, and this says which one a run uses. Relative
  // paths are relative to the repository, and deps/ is the default.
  "toolchain": "deps",

  // Milliseconds, and what a run may spend on one question. A proof is written
  // so that every step is cheap, so these are small on purpose: a budget that
  // has to be raised usually says the step is too big rather than the budget
  // too small. `run_status` reports the ones a run resolved to.
  "timeouts": {
    // What the check tool uses when the agent names no timeout.
    // "check_default_ms": 30000,
    // The most the agent may ask that tool for.
    // "check_cap_ms": 60000,
    // The check that follows every certified step.
    // "eager_check_ms": 3000,
    // What a commit is validated with.
    // "alive2_ms": 30000,
    // How long one llubi run may take before it is killed.
    // "llubi_ms": 60000
  },
}
