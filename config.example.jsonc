// Every option a configuration can carry, with its default. Copy this file to
// config.jsonc, which is machine-local and gitignored, and uncomment what you
// want to change. Nothing has to be set: every option here has a default.
{
  // Where LLVM, alive2, llubi and llops were built. They read and write the
  // same IR, so they have to be one build against one LLVM; `make install-deps
  // TOOLCHAIN=<dir>` builds it, and this says which one a run uses. Relative
  // paths are relative to the repository, and deps/ is the default.
  "toolchain": "deps",

  // Milliseconds. check_default_ms is what the check tool uses when the agent
  // names no timeout, and check_cap_ms is the most it may ask for.
  "timeouts": {
    // "check_default_ms": 30000,
    // "check_cap_ms": 300000,
    // "eager_check_ms": 5000,
    // "alive2_ms": 120000,
    // "llubi_ms": 30000
  },
}
